<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HanumanInstitute.SynthMultiViewer.ViewModels"
        x:Class="HanumanInstitute.SynthMultiViewer.Views.SavePresetView"
        x:DataType="vm:SavePresetViewModel"
        Title="{Binding DisplayName}"
        Width="320" Height="360"
        MinWidth="296" MinHeight="260"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="StackPanel.dialog-actions > Button">
            <Setter Property="MinWidth" Value="64" />
        </Style>
    </Window.Styles>
    <DockPanel Classes="dialog-content">
        <StackPanel DockPanel.Dock="Bottom" Classes="dialog-actions">
            <Button Content="Reset" Command="{Binding Reset}" />
            <Button Content="Delete" Command="{Binding Delete}" />
            <Button Content="Cancel" IsCancel="True" Command="{Binding Close}" />
            <Button Content="OK" IsDefault="True" Command="{Binding Ok}" />
        </StackPanel>
        <DockPanel>
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                     Text="{Binding PresetName}" PlaceholderText="Name" />
            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Presets.CurrentItem}"
                     DoubleTapped="OnPresetDoubleTapped" />
        </DockPanel>
    </DockPanel>
</Window>
