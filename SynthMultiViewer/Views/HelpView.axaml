<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HanumanInstitute.SynthMultiViewer.ViewModels"
        x:Class="HanumanInstitute.SynthMultiViewer.Views.HelpView"
        x:DataType="vm:HelpViewModel"
        Title="About Synth Multi-Viewer"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Classes="dialog-content">
        <StackPanel DockPanel.Dock="Bottom" Classes="dialog-actions">
            <Button Content="Close" IsCancel="True" IsDefault="True" Command="{Binding Close}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <DockPanel>
                <HyperlinkButton DockPanel.Dock="Right" Content="GitHub"
                                 NavigateUri="https://github.com/mysteryx93/SynthMultiViewer/"
                                 FontSize="14" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="/Assets/App.webp" Width="48" Height="48" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           VerticalAlignment="Center" />
                    <TextBlock FontSize="20" Text="{Binding AppVersion, StringFormat='Synth Multi-Viewer v{0}'}"
                               VerticalAlignment="Center" />
                    <HyperlinkButton Content="{Binding CheckForUpdateText}"
                                     NavigateUri="https://github.com/mysteryx93/SynthMultiViewer/releases"
                                     FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="Editor and viewer for VapourSynth and AviSynth" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="14" Text="by " VerticalAlignment="Center" />
                <HyperlinkButton Content="Etienne Charland" NavigateUri="https://www.hanumaninstitute.com"
                                 FontSize="14" VerticalAlignment="Center" />
                <TextBlock FontSize="14" Text=" — Coherence programming" VerticalAlignment="Center" />
            </StackPanel>
            <Grid x:Name="ShortcutColumns" ColumnDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="16" Margin="0,10,0,0">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="File" />
                    <TextBlock LineHeight="20" TextWrapping="NoWrap">
                        <Run Text="F1: Help" /><LineBreak />
                        <Run Text="Ctrl+,: Settings" /><LineBreak />
                        <Run Text="Ctrl+N: New VapourSynth" /><LineBreak />
                        <Run Text="Ctrl+M: New AviSynth" /><LineBreak />
                        <Run Text="Ctrl+O: Open" /><LineBreak />
                        <Run Text="Ctrl+S: Save" /><LineBreak />
                        <Run Text="Ctrl+Shift+S: Save as" /><LineBreak />
                        <Run Text="F5: Run" /><LineBreak />
                        <Run Text="Ctrl+F4: Close tab" />
                    </TextBlock>
                    <TextBlock FontWeight="SemiBold" Text="Tabs" />
                    <TextBlock LineHeight="20" TextWrapping="NoWrap">
                        <Run Text="F2 / Click: Rename" /><LineBreak />
                        <Run Text="Ctrl+T: Tab color" /><LineBreak />
                        <Run Text="Ctrl+Tab: Next" /><LineBreak />
                        <Run Text="Ctrl+Shift+Tab: Previous" /><LineBreak />
                        <Run Text="Ctrl+1-9: Select tab" /><LineBreak />
                        <Run Text="Alt+Left: Move tab left" /><LineBreak />
                        <Run Text="Alt+Right: Move tab right" /><LineBreak />
                        <Run Text="Drag: Reorder" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="Editor" />
                    <TextBlock LineHeight="20" TextWrapping="NoWrap">
                        <Run Text="Ctrl+Space: Completion" /><LineBreak />
                        <Run Text="Ctrl+Shift+Space: Parameter info" /><LineBreak />
                        <Run Text="Ctrl+Shift+R: Refresh catalogs" /><LineBreak />
                        <Run Text="Ctrl+E: Functions explorer" /><LineBreak />
                        <Run Text="Esc: Dismiss popups" />
                    </TextBlock>
                    <TextBlock FontWeight="SemiBold" Text="Viewer" />
                    <TextBlock LineHeight="20" TextWrapping="NoWrap">
                        <Run Text="Left-drag: Pan" /><LineBreak />
                        <Run Text="Scroll, +/-: Zoom in / out" /><LineBreak />
                        <Run Text="Right click: Reset zoom" /><LineBreak />
                        <Run Text="Space: Play/Pause" /><LineBreak />
                        <Run Text="Left / Right: Seek 1 frame" /><LineBreak />
                        <Run Text="Ctrl+Left: Back 10 frames" /><LineBreak />
                        <Run Text="Ctrl+Right: Forward 10 frames" /><LineBreak />
                        <Run Text="Ctrl+G: Go to frame" /><LineBreak />
                        <Run Text="Ctrl+C: Copy frame" /><LineBreak />
                        <Run Text="Ctrl+I: Video properties" /><LineBreak />
                        <Run Text="Ctrl+F6: Load frame in all tabs" /><LineBreak />
                        <Run Text="F8: Multi-threading" /><LineBreak />
                        <Run Text="F9: Square pixels" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="Edit" />
                    <TextBlock LineHeight="20" TextWrapping="NoWrap">
                        <Run Text="Ctrl+Z / Ctrl+Y: Undo, Redo" /><LineBreak />
                        <Run Text="Ctrl+D: Delete line" /><LineBreak />
                        <Run Text="Tab: Indent" /><LineBreak />
                        <Run Text="Shift+Tab: Unindent" /><LineBreak />
                        <Run Text="Ctrl+Backspace: Delete word left" /><LineBreak />
                        <Run Text="Ctrl+Delete: Delete word right" />
                    </TextBlock>
                    <TextBlock FontWeight="SemiBold" Text="Search" />
                    <TextBlock LineHeight="20" TextWrapping="NoWrap">
                        <Run Text="Ctrl+F: Find" /><LineBreak />
                        <Run Text="Ctrl+H: Replace" /><LineBreak />
                        <Run Text="F3: Find next" /><LineBreak />
                        <Run Text="Shift+F3: Find previous" /><LineBreak />
                        <Run Text="Alt+R: Replace next" /><LineBreak />
                        <Run Text="Alt+A: Replace all" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
