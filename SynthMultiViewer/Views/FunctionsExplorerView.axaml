<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:HanumanInstitute.SynthMultiViewer.Helpers"
        xmlns:sa="using:HanumanInstitute.ScriptAssist"
        xmlns:vm="using:HanumanInstitute.SynthMultiViewer.ViewModels"
        xmlns:converters="using:Avalonia.Data.Converters"
        x:Class="HanumanInstitute.SynthMultiViewer.Views.FunctionsExplorerView"
        x:DataType="vm:FunctionsExplorerViewModel"
        Title="{Binding DisplayName}"
        Width="{Binding Placement.Width, Mode=TwoWay}"
        Height="{Binding Placement.Height, Mode=TwoWay}"
        MinWidth="360" MinHeight="240"
        h:WindowBounds.Left="{Binding Placement.Left, Mode=TwoWay}"
        h:WindowBounds.Top="{Binding Placement.Top, Mode=TwoWay}"
        CanResize="True" CanMaximize="False" CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding Close}" />
    </Window.KeyBindings>
    <Window.Styles>
        <Style Selector="ToolTip">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="MaxWidth" Value="960" />
        </Style>
        <Style Selector="ToolTip TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="960" />
            <Setter Property="MaxLines" Value="16" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="OverlayPopupHost">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Styles>
    <DockPanel Classes="dialog-content">
        <StackPanel DockPanel.Dock="Bottom" Classes="dialog-actions">
            <Button Content="Go To" Command="{Binding GoTo}"
                    IsVisible="{Binding CanGoTo}" />
            <Button Content="Refresh" Command="{Binding Refresh}" />
            <Button Content="Insert" IsDefault="True" Command="{Binding Insert}"
                    IsEnabled="{Binding CanInsert}" />
            <Button Content="Close" Command="{Binding Close}" />
        </StackPanel>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       IsVisible="{Binding Error, Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox x:Name="Search" Classes="search" PlaceholderText="Search"
                         h:FocusBehavior.WhenVisible="True"
                         Text="{Binding Filter, Mode=TwoWay}" />
                <Button Classes="clear-search" Command="{Binding ClearFilter}"
                        IsVisible="{Binding IsSearching}" ToolTip.Tip="Clear search"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" />
                </Button>
            </Grid>
            <Grid>
                <Grid ColumnDefinitions="160,*" ColumnSpacing="8" IsVisible="{Binding !IsSearching}">
                    <ListBox x:Name="GroupsList" Classes="compact" ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="sa:BrowseGroup">
                                <Border Background="Transparent" Padding="4,0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        ToolTip.Tip="{Binding Tip}"
                                        ToolTip.Placement="Pointer"
                                        ToolTip.ShouldUseOverlayLayer="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                        <Image Width="16" Height="16" VerticalAlignment="Center"
                                               Source="{Binding Kind, Converter={x:Static h:SymbolKindImageConverter.Instance}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="FunctionsList" Grid.Column="1" Classes="compact"
                             ItemsSource="{Binding Functions}"
                             SelectedItem="{Binding SelectedFunction}"
                             DoubleTapped="OnFunctionDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="sa:BrowseFunction">
                                <Border Background="Transparent" Padding="4,0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        ToolTip.Tip="{Binding Signature}"
                                        ToolTip.Placement="Pointer"
                                        ToolTip.ShouldUseOverlayLayer="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                        <Image Width="16" Height="16" VerticalAlignment="Center"
                                               Source="{Binding Kind, Converter={x:Static h:SymbolKindImageConverter.Instance}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <ListBox x:Name="HitsList" Classes="compact" IsVisible="{Binding IsSearching}"
                         ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}"
                         DoubleTapped="OnFunctionDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FunctionHit">
                            <Border Background="Transparent" Padding="4,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    ToolTip.Tip="{Binding Signature}"
                                    ToolTip.Placement="Pointer"
                                    ToolTip.ShouldUseOverlayLayer="True">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Image Width="16" Height="16" Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Source="{Binding Function.Kind, Converter={x:Static h:SymbolKindImageConverter.Instance}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Function.Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Group}" Opacity="0.55"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
