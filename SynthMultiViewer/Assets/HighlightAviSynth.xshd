<SyntaxDefinition name="AviSynth" extensions=".avs;.avsi" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground="Green" />
	<Color name="String" foreground="Red" />
	<Color name="Keyword" foreground="Blue" fontWeight="bold" />
	<Color name="Builtin" foreground="MidnightBlue" fontWeight="bold" />
	<Color name="Digits" foreground="DarkBlue" />
	<RuleSet ignoreCase="true">
		<Span color="Comment">
			<Begin>\#</Begin>
		</Span>
		<Span color="Comment" multiline="true">
			<Begin>/\*</Begin>
			<End>\*/</End>
		</Span>
		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
		</Span>
		<Span color="String">
			<Begin>'</Begin>
			<End>'</End>
		</Span>
		<Keywords color="Keyword">
			<Word>function</Word>
			<Word>global</Word>
			<Word>return</Word>
			<Word>try</Word>
			<Word>catch</Word>
			<Word>if</Word>
			<Word>else</Word>
			<Word>while</Word>
			<Word>for</Word>
			<Word>true</Word>
			<Word>false</Word>
			<Word>last</Word>
		</Keywords>
		<Rule color="Builtin">\b[\w_]+(?=\()</Rule>
		<Rule color="Digits">\b\d+(\.\d+)?\b</Rule>
	</RuleSet>
</SyntaxDefinition>
