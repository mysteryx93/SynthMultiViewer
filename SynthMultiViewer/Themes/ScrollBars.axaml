<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <x:Double x:Key="AppScrollBarSize">7</x:Double>
            <CornerRadius x:Key="AppScrollBarRadius">4</CornerRadius>
            <SolidColorBrush x:Key="AppScrollBarTrack" Color="{DynamicResource SystemBaseLowColor}" />
            <SolidColorBrush x:Key="AppScrollBarThumb" Color="{DynamicResource SystemBaseMediumColor}" />
            <SolidColorBrush x:Key="AppScrollBarThumbPointerOver" Color="{DynamicResource SystemBaseMediumHighColor}" />
            <SolidColorBrush x:Key="AppScrollBarThumbPressed" Color="{DynamicResource SystemBaseHighColor}" />

            <ControlTheme x:Key="AppScrollBarPageButton" TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="AppScrollBarThumbVertical" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource AppScrollBarThumb}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="UseLayoutRounding" Value="False" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_ThumbFill" Margin="0,0.8"
                                CornerRadius="{DynamicResource AppScrollBarRadius}"
                                ClipToBounds="False" UseLayoutRounding="False"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource AppScrollBarThumbPointerOver}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background" Value="{DynamicResource AppScrollBarThumbPressed}" />
                </Style>
                <Style Selector="^:disabled /template/ Border#PART_ThumbFill">
                    <Setter Property="Opacity" Value="0.4" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="AppScrollBarThumbHorizontal" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource AppScrollBarThumb}" />
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="UseLayoutRounding" Value="False" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_ThumbFill" Margin="0.8,0"
                                CornerRadius="{DynamicResource AppScrollBarRadius}"
                                ClipToBounds="False" UseLayoutRounding="False"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource AppScrollBarThumbPointerOver}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background" Value="{DynamicResource AppScrollBarThumbPressed}" />
                </Style>
                <Style Selector="^:disabled /template/ Border#PART_ThumbFill">
                    <Setter Property="Opacity" Value="0.4" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
                <Setter Property="MinWidth" Value="{DynamicResource AppScrollBarSize}" />
                <Setter Property="MinHeight" Value="{DynamicResource AppScrollBarSize}" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="UseLayoutRounding" Value="False" />
                <Setter Property="Background" Value="{DynamicResource AppScrollBarTrack}" />
                <Style Selector="^:vertical">
                    <Setter Property="Width" Value="{DynamicResource AppScrollBarSize}" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="PART_Gutter" Background="{TemplateBinding Background}"
                                    Width="{DynamicResource AppScrollBarSize}"
                                    ClipToBounds="False" UseLayoutRounding="False">
                                <Track ClipToBounds="False" UseLayoutRounding="False"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Orientation="{TemplateBinding Orientation}"
                                       DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseButton>
                                        <RepeatButton Name="PART_PageUpButton"
                                                      Theme="{StaticResource AppScrollBarPageButton}"
                                                      Focusable="False"
                                                      AutomationProperties.Name="Page up" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton Name="PART_PageDownButton"
                                                      Theme="{StaticResource AppScrollBarPageButton}"
                                                      Focusable="False"
                                                      AutomationProperties.Name="Page down" />
                                    </Track.IncreaseButton>
                                    <Track.Thumb>
                                        <Thumb Theme="{StaticResource AppScrollBarThumbVertical}"
                                               AutomationProperties.Name="Position" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="^:horizontal">
                    <Setter Property="Height" Value="{DynamicResource AppScrollBarSize}" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="PART_Gutter" Background="{TemplateBinding Background}"
                                    Height="{DynamicResource AppScrollBarSize}"
                                    ClipToBounds="False" UseLayoutRounding="False">
                                <Track ClipToBounds="False" UseLayoutRounding="False"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Orientation="{TemplateBinding Orientation}"
                                       DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
                                    <Track.DecreaseButton>
                                        <RepeatButton Name="PART_PageUpButton"
                                                      Theme="{StaticResource AppScrollBarPageButton}"
                                                      Focusable="False"
                                                      AutomationProperties.Name="Page left" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton Name="PART_PageDownButton"
                                                      Theme="{StaticResource AppScrollBarPageButton}"
                                                      Focusable="False"
                                                      AutomationProperties.Name="Page right" />
                                    </Track.IncreaseButton>
                                    <Track.Thumb>
                                        <Thumb Theme="{StaticResource AppScrollBarThumbHorizontal}"
                                               AutomationProperties.Name="Position" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="ScrollViewer /template/ Panel#PART_ScrollBarsSeparator">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</Styles>
