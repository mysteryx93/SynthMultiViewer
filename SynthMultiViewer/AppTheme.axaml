<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:vm="using:HanumanInstitute.SynthMultiViewer.ViewModels"
        xmlns:h="using:HanumanInstitute.SynthMultiViewer.Helpers"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:drag="using:Avalonia.Xaml.Interactions.Draggable">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MediaPlayer.Avalonia/Styles/Default/Theme.axaml" />
                <ResourceInclude Source="/Themes/ViewerPlayer.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToolbarButtonPointerOver" Color="#14000000" />
                    <SolidColorBrush x:Key="ToolbarButtonPressed" Color="#1A000000" />
                    <SolidColorBrush x:Key="ToolbarButtonChecked" Color="#18000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ToolbarButtonPointerOver" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ToolbarButtonPressed" Color="#44FFFFFF" />
                    <SolidColorBrush x:Key="ToolbarButtonChecked" Color="#28FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ControlTheme x:Key="{x:Type TabStripItem}" TargetType="TabStripItem">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="{DynamicResource TabItemHeaderThemeFontWeight}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundUnselected}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border Name="PART_Tint"
                                    Background="{Binding TabBackground, x:DataType=vm:IScriptViewModel}"
                                    IsHitTestVisible="False" />
                            <Border Name="PART_LayoutRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <Panel>
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    <Border Name="PART_SelectedPipe"
                                            Background="{DynamicResource TabItemHeaderSelectedPipeFill}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Height="{DynamicResource TabStripItemPipeThickness}"
                                            Margin="0,0,0,3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                            IsVisible="False" />
                                </Panel>
                            </Border>
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundSelected}" />
                </Style>
                <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundDisabled}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundDisabled}" />
                </Style>
                <Style Selector="^:dragging">
                    <Setter Property="ZIndex" Value="1" />
                    <Setter Property="Opacity" Value="0.9" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
    <FluentTheme>
        <FluentTheme.Palettes>
            <ColorPaletteResources x:Key="Dark"
                                   RegionColor="#FF1C1C1C"
                                   AltHigh="#FF1C1C1C"
                                   ChromeLow="#FF242424"
                                   ChromeMedium="#FF2B2B2B"
                                   ChromeMediumLow="#FF353535"
                                   ChromeDisabledHigh="#FF424242" />
        </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Themes/ScrollBars.axaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="TabStripItem">
        <Setter Property="(i:Interaction.Behaviors)">
            <BehaviorCollectionTemplate>
                <BehaviorCollection>
                    <drag:ItemDragBehavior Orientation="Horizontal" />
                </BehaviorCollection>
            </BehaviorCollectionTemplate>
        </Setter>
    </Style>
    <!-- Shared control alignment and dialog layout. -->
    <Style Selector="Window">
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="Button, ToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="StackPanel.start-tiles">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.start-tile">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="132" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="MinHeight" Value="132" />
        <Setter Property="Padding" Value="12,14" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.start-tile Image">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.start-tile TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0,4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.compact">
        <Setter Property="AutoScrollToSelectedItem" Value="True" />
        <Setter Property="IsTextSearchEnabled" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="h:ListBoxTextSearch.Enabled" Value="True" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="0,0,14,0" BorderThickness="2"
                        BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}"
                        IsHitTestVisible="False" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MaxHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="2"
                        BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}"
                        IsHitTestVisible="False" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0,6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="Padding" Value="8,0,28,0" />
    </Style>
    <Style Selector="Button.clear-search">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.clear-search Path">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.25" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="HyperlinkButton">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="DockPanel.dialog-content">
        <Setter Property="Margin" Value="8,6" />
    </Style>
    <Style Selector="StackPanel.dialog-actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="StackPanel.dialog-actions > Button">
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0,6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="NaN" />
    </Style>
    <Style Selector="edit|TextEditor">
        <Setter Property="FontFamily" Value="Consolas,Menlo,Monospace" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="ShowLineNumbers" Value="True" />
        <Setter Property="LineNumbersMargin" Value="4,0,10,0" />
        <Setter Property="WordWrap" Value="False" />
    </Style>
    <Style Selector="StackPanel.toolbar > Button, StackPanel.toolbar > ToggleButton">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style Selector="StackPanel.toolbar > Button:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     StackPanel.toolbar > ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToolbarButtonPointerOver}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="StackPanel.toolbar > Button:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     StackPanel.toolbar > ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToolbarButtonPressed}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="StackPanel.toolbar > ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToolbarButtonChecked}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="StackPanel.toolbar > ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToolbarButtonPointerOver}" />
    </Style>
    <Style Selector="StackPanel.toolbar > Button:disabled, StackPanel.toolbar > ToggleButton:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="StackPanel.toolbar > Button:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     StackPanel.toolbar > ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="StackPanel.toolbar Image">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
    </Style>
    <Style Selector="StackPanel.toolbar > Separator">
        <Setter Property="Width" Value="1" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="Margin" Value="2,8" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="1" Background="{TemplateBinding Background}" VerticalAlignment="Stretch" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Image.enabled">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Image.enabled:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.tab-close">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.tab-close Path">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.25" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="TextBox.tab-header-edit">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="1,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.tab-header-edit:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox.zoom">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style Selector="ComboBox.zoom:pressed /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}" />
    </Style>
    <Style Selector="ComboBox.zoom:focus-within /template/ Border#Background,
                     ComboBox.zoom:focus-within /template/ Border#HighlightBackground">
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
    </Style>
    <Style Selector="ComboBox.zoom:focus-within /template/ Border#HighlightBackground">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox.zoom /template/ Border#DropDownOverlay">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Width" Value="24" />
        <Setter Property="CornerRadius" Value="0,3,3,0" />
    </Style>
    <Style Selector="ComboBox.zoom /template/ Border#DropDownOverlay:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
    </Style>
    <Style Selector="ComboBox.zoom:pressed /template/ Border#DropDownOverlay,
                     ComboBox.zoom:dropdownopen /template/ Border#DropDownOverlay">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
    </Style>
    <Style Selector="ComboBox.zoom /template/ PathIcon#DropDownGlyph">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="ComboBox.zoom /template/ TextBox#PART_EditableTextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4,0,1,0" />
        <Setter Property="Margin" Value="0,0,24,0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style Selector="ComboBox.zoom /template/ TextBox#PART_EditableTextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.detected-path">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="NaN" />
    </Style>
    <Style Selector="TextBox.detected-path /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
